meta {
  name: Upload Image
  type: http
  seq: 1
}

post {
  url: {{base_url}}/upload/image
  body: multipartForm
  auth: none
}

headers {
  x-user-id: {{user_id}}
}

// Replace the path below with your actual medical report image before running.
// Example: @file(/Users/you/Desktop/report.jpg)
body:multipart-form {
  file: @file(/path/to/your/medical-report.jpg)
}
