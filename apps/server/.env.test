# E2E 测试专用环境变量
# 用法: 启动 docker-compose.test.yml 后, 以此文件运行 server
# env-cmd -f .env.test pnpm dev  或  直接覆盖到 .env

PORT=3000

# ── 测试数据库（docker-compose.test.yml 的 5433 端口）──
DATABASE_URL=postgresql://postgres:test@localhost:5433/echohealth_test
REDIS_URL=redis://localhost:6380

# ── 认证（e2e 测试用固定值）──
JWT_SECRET=e2e-test-secret-not-for-production
GOOGLE_CLIENT_ID=test-google-client-id

# ── 视频生成（e2e 跳过真实管线）──
TEST_FAST_VIDEO=true

# ── Creem 支付测试模式（填入你的 test key）──
# CREEM_API_KEY=creem_test_xxx
# CREEM_WEBHOOK_SECRET=whsec_xxx
# CREEM_PRODUCT_MONTHLY=prod_xxx
# CREEM_PRODUCT_PASS=prod_xxx

# ── COS（e2e 不需要真实上传，upload 会报错但不影响大部分测试）──
# 如需测试完整上传流程，填入 COS 凭证
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=
# COS_REGION=ap-guangzhou
