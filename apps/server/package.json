{
  "name": "server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "start": "node --import ./dist/instrument.js dist/index.js",
    "start:worker": "node --import ./dist/instrument.js dist/queue/start-worker.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@google/genai": "^1.45.0",
    "@prisma/adapter-pg": "7.4.1",
    "@prisma/client": "^7.4.1",
    "@remotion/bundler": "4.0.429",
    "@remotion/renderer": "4.0.429",
    "@sentry/node": "^10.43.0",
    "@types/pg": "^8.16.0",
    "bullmq": "^5.70.1",
    "cos-nodejs-sdk-v5": "^2.15.4",
    "dotenv": "^16.0.0",
    "fastify": "^5.0.0",
    "fastify-raw-body": "^5.0.0",
    "google-auth-library": "^10.6.1",
    "ioredis": "^5.9.3",
    "jsonwebtoken": "^9.0.3",
    "langfuse": "^3.38.6",
    "openai": "^4.77.0",
    "pdfjs-dist": "^5.5.207",
    "pg": "^8.19.0",
    "sharp": "^0.34.5",
    "tencentcloud-sdk-nodejs-ocr": "^4.1.187"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.12.0",
    "@testcontainers/redis": "^11.12.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@types/sharp": "^0.32.0",
    "prisma": "^7.4.1",
    "testcontainers": "^11.12.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
